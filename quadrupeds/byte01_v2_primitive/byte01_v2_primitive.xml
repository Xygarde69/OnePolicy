        <geom name="hip_rr_hub" class="visual" type="cylinder" pos="0 0 -0.02" quat="0.7071068 0.7071068 0 0" size="0.045 0.025" rgba="0.8 0.52 0.16 1"/>
        <body name="thigh_rr" pos="-0.028 0 -0.072631">
          <inertial pos="-0.061426225 -0.0361303394 -0.00522454183" mass="1.38"
                    fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851942e-06 -1.02239875e-06 -0.000127235798"/>
          <joint name="thigh_rr" axis="-1 0 0" range="-1.57 1.57"/>
          <geom name="thigh_rr_geom" class="visual" type="capsule" fromto="0 0 0 -0.08928 -0.21278 0.0096672" size="0.027" rgba="0.18 0.65 0.42 1"/>
          <geom name="thigh_rr_joint_housing" class="visual" type="sphere" pos="0 0 0" size="0.039" rgba="0.8 0.52 0.16 1"/>
          <body name="calf_rr" pos="-0.08928 -0.21278 0.0096672">
            <inertial pos="0.00314980527 -0.138408659 -0.0146238989" mass="1.38"
                      fullinertia="0.00659921015 0.000624563237 0.00623224513 -2.80823743e-09 -4.74862427e-09 -0.00141145749"/>
            <joint name="knee_rr" axis="-1 0 0" range="-2.5 2.5"/>
            <geom name="calf_rr_geom" class="collision" type="capsule" fromto="0 0 0 0 -0.245 0" size="0.022" rgba="0.72 0.76 0.81 1"/>
            <geom name="foot_rr" class="collision" type="sphere" pos="0 -0.245 0" size="0.032" rgba="0.12 0.13 0.15 1"/>
          </body>
        </body>
      </body>

      <!-- Rear-left -->
      <body name="hip_rl" pos="-0.065 -0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="-0.00107903741 -1.9324591e-05 -0.0598853177" mass="1.38"
                  fullinertia="0.00163362208 0.00109655026 0.000919080121 -4.27382957e-07 -2.46750206e-07 3.70044953e-07"/>
        <joint name="hip_rl" axis="0 0 1" range="-0.8 0.8"/>
        <geom name="hip_rl_geom" class="visual" type="capsule" fromto="0 0 0 0 0 -0.105" size="0.035"/>
        <geom name="hip_rl_hub" class="visual" type="cylinder" pos="0 0 -0.02" quat="0.7071068 0.7071068 0 0" size="0.045 0.025" rgba="0.8 0.52 0.16 1"/>
        <body name="thigh_rl" pos="0.028 0 -0.072631">
          <inertial pos="0.0614262309 -0.0367304728 -0.00484072113" mass="1.38"
                    fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851911e-06 -1.02239924e-06 -0.000127235798"/>
          <joint name="thigh_rl" axis="1 0 0" range="-1.57 1.57"/>
          <geom name="thigh_rl_geom" class="visual" type="capsule" fromto="0 0 0 0.079 -0.21278 0.0096672" size="0.027" rgba="0.18 0.65 0.42 1"/>
          <geom name="thigh_rl_joint_housing" class="visual" type="sphere" pos="0 0 0" size="0.039" rgba="0.8 0.52 0.16 1"/>
          <body name="calf_rl" pos="0.079 -0.21278 0.0096672">
            <inertial pos="0.00713020527 -0.138408977 -0.0146239567" mass="1.38"
                      fullinertia="0.00659919894 0.000624564926 0.00623223272 -2.80825341e-09 -4.74876255e-09 -0.00141145614"/>
            <joint name="knee_rl" axis="-1 0 0" range="-2.5 2.5"/>
