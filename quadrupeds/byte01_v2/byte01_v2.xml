<mujoco model="DOggo_AK60">
  <!--
    DOggo quadruped converted from the SolidWorks URDF, with AK60-6 V3.0 (KV80) joint actuators
    + external 5.8:1 stage, 70 % efficiency on the external stage, 48 V bus.
    =============================================================================================
    total ratio              = 6 * 5.8                   = 34.8
    joint peak torque        = 9 Nm  * 5.8 * 0.70        = 36.54 Nm
    joint rated torque       = 3 Nm  * 5.8 * 0.70        = 12.18 Nm
    joint no-load speed      = 640 rpm / 5.8             = 11.55 rad/s
    joint rated speed        = 490 rpm / 5.8             = 8.85 rad/s
    reflected rotor inertia  = 2.435e-5 kg m^2 * 34.8^2  = 0.0295 kg m^2 (joint armature)
    dry friction (back-drive)= 0.2 Nm * 5.8 / 0.70       = 1.66 Nm      (joint frictionloss)
    link mass                = 0.38 (AK60) + 1.0         = 1.38 kg ; base_link = 10 kg
      (original CAD inertias are scaled by new_mass / CAD_mass, CoM positions unchanged)

    Frame notes: the robot's long axis is +Y (front legs at y = +0.166); legs hang along -Z.
    Hip joints rotate about the long axis, thigh/knee joints about X.
    Actuators = direct torque (motor), one ctrl per joint [Nm], clamped to +-36.54 Nm.
      ctrl order: hip, thigh, knee for FR, FL, RR, RL  -> 12 values
  -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <joint armature="0.0295" damping="0.1" frictionloss="1.66" actuatorfrcrange="-36.54 36.54"/>
    <motor ctrlrange="-36.54 36.54"/>
    <default class="visual">
      <geom type="mesh" rgba="1 1 1 1" contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="collision">
      <geom type="mesh" rgba="1 1 1 1" contype="1" conaffinity="0" friction="1 0.005 0.0001"/>
    </default>
  </default>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.6 0.75 0.9" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.28 0.32" rgb2="0.18 0.2 0.24" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" texuniform="true" reflectance="0.1"/>

    <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
    <mesh name="hip_fr" content_type="model/stl" file="hip_fr.STL"/>
    <mesh name="thigh_fr" content_type="model/stl" file="thigh_fr.STL"/>
    <mesh name="calf_fr" content_type="model/stl" file="calf_fr.STL"/>
    <mesh name="hip_fl" content_type="model/stl" file="hip_fl.STL"/>
    <mesh name="thigh_fl" content_type="model/stl" file="thigh_fl.STL"/>
    <mesh name="calf_fl" content_type="model/stl" file="calf_fl.STL"/>
    <mesh name="hip_rr" content_type="model/stl" file="hip_rr.STL"/>
    <mesh name="thigh_rr" content_type="model/stl" file="thigh_rr.STL"/>
    <mesh name="calf_rr" content_type="model/stl" file="calf_rr.STL"/>
    <mesh name="hip_rl" content_type="model/stl" file="hip_rl.STL"/>
    <mesh name="thigh_rl" content_type="model/stl" file="thigh_rl.STL"/>
    <mesh name="calf_rl" content_type="model/stl" file="calf_rl.STL"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <body name="base_link" pos="0 0 0.62">
      <freejoint name="root"/>
      <inertial pos="-1.39141166e-07 -0.000102367832 0.0376848659" mass="10.0" fullinertia="0.0692760121 0.0348926756 0.0901430041 -1.99000196e-06 2.93265177e-07 -4.73894399e-07"/>
      <geom name="base_geom" class="collision" mesh="base_link"/>
      <site name="imu" pos="0 0 0" size="0.01"/>

      <!-- ======================= FR ======================= -->
      <body name="hip_fr" pos="0.065 0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="0.00107903741 -1.9324591e-05 0.0598853177" mass="1.38" fullinertia="0.00163362208 0.00109655026 0.000919080121 4.27382957e-07 -2.46750206e-07 -3.70044953e-07"/>
        <joint name="hip_fr" axis="0 0 1" range="-0.8 0.8"/>
        <geom class="visual" mesh="hip_fr"/>
        <body name="thigh_fr" pos="-0.028 0 0.072631">
          <inertial pos="-0.061426225 -0.0361303394 -0.00522454183" mass="1.38" fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851942e-06 -1.02239875e-06 -0.000127235798"/>
          <joint name="thigh_fr" axis="-1 0 0" range="-1.57 1.57"/>
          <geom class="visual" mesh="thigh_fr"/>
          <body name="calf_fr" pos="-0.08928 -0.21278 0.0096672">
            <inertial pos="0.00314980527 -0.138408659 -0.0146238989" mass="1.38" fullinertia="0.00659921015 0.000624563237 0.00623224513 -2.80823743e-09 -4.74862427e-09 -0.00141145749"/>
            <joint name="knee_fr" axis="1 0 0" range="-2.5 2.5"/>
            <geom class="collision" mesh="calf_fr"/>
          </body>
        </body>
      </body>
      <!-- ======================= FL ======================= -->
      <body name="hip_fl" pos="-0.065 0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="-0.00107903741 1.9324591e-05 0.0598853177" mass="1.38" fullinertia="0.00163362208 0.00109655026 0.000919080121 4.27382957e-07 2.46750206e-07 3.70044953e-07"/>
        <joint name="hip_fl" axis="0 0 -1" range="-0.8 0.8"/>
        <geom class="visual" mesh="hip_fl"/>
        <body name="thigh_fl" pos="0.028 0 0.072631">
          <inertial pos="0.0614262309 -0.0367304728 -0.00484072113" mass="1.38" fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851911e-06 -1.02239924e-06 -0.000127235798"/>
          <joint name="thigh_fl" axis="1 0 0" range="-1.57 1.57"/>
          <geom class="visual" mesh="thigh_fl"/>
          <body name="calf_fl" pos="0.079 -0.21278 0.0096672">
            <inertial pos="0.00713020527 -0.138408977 -0.0146239567" mass="1.38" fullinertia="0.00659919894 0.000624564926 0.00623223272 -2.8086668e-09 -4.74876255e-09 -0.00141145614"/>
            <joint name="knee_fl" axis="1 0 0" range="-2.5 2.5"/>
            <geom class="collision" mesh="calf_fl"/>
          </body>
        </body>
      </body>
      <!-- ======================= RR ======================= -->
      <body name="hip_rr" pos="0.065 -0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="0.00107903741 1.93245911e-05 -0.0598853177" mass="1.38" fullinertia="0.00163362208 0.00109655026 0.000919080121 -4.27382957e-07 2.46750206e-07 -3.70044953e-07"/>
        <joint name="hip_rr" axis="0 0 -1" range="-0.8 0.8"/>
        <geom class="visual" mesh="hip_rr"/>
        <body name="thigh_rr" pos="-0.028 0 -0.072631">
          <inertial pos="-0.061426225 -0.0361303394 -0.00522454183" mass="1.38" fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851942e-06 -1.02239875e-06 -0.000127235798"/>
          <joint name="thigh_rr" axis="-1 0 0" range="-1.57 1.57"/>
          <geom class="visual" mesh="thigh_rr"/>
          <body name="calf_rr" pos="-0.08928 -0.21278 0.0096672">
            <inertial pos="0.00314980527 -0.138408659 -0.0146238989" mass="1.38" fullinertia="0.00659921015 0.000624563237 0.00623224513 -2.80823743e-09 -4.74862427e-09 -0.00141145749"/>
            <joint name="knee_rr" axis="-1 0 0" range="-2.5 2.5"/>
            <geom class="collision" mesh="calf_rr"/>
          </body>
        </body>
      </body>
      <!-- ======================= RL ======================= -->
      <body name="hip_rl" pos="-0.065 -0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="-0.00107903741 -1.9324591e-05 -0.0598853177" mass="1.38" fullinertia="0.00163362208 0.00109655026 0.000919080121 -4.27382957e-07 -2.46750206e-07 3.70044953e-07"/>
        <joint name="hip_rl" axis="0 0 1" range="-0.8 0.8"/>
        <geom class="visual" mesh="hip_rl"/>
        <body name="thigh_rl" pos="0.028 0 -0.072631">
          <inertial pos="0.0614262309 -0.0367304728 -0.00484072113" mass="1.38" fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851911e-06 -1.02239924e-06 -0.000127235798"/>
          <joint name="thigh_rl" axis="1 0 0" range="-1.57 1.57"/>
          <geom class="visual" mesh="thigh_rl"/>
          <body name="calf_rl" pos="0.079 -0.21278 0.0096672">
            <inertial pos="0.00713020527 -0.138408659 -0.0146238989" mass="1.38" fullinertia="0.00659921015 0.000624563237 0.00623224513 -2.80825341e-09 -4.74862861e-09 -0.00141145749"/>
            <joint name="knee_rl" axis="-1 0 0" range="-2.5 2.5"/>
            <geom class="collision" mesh="calf_rl"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="act_hip_fr" joint="hip_fr"/>
    <motor name="act_thigh_fr" joint="thigh_fr"/>
    <motor name="act_knee_fr" joint="knee_fr"/>
    <motor name="act_hip_fl" joint="hip_fl"/>
    <motor name="act_thigh_fl" joint="thigh_fl"/>
    <motor name="act_knee_fl" joint="knee_fl"/>
    <motor name="act_hip_rr" joint="hip_rr"/>
    <motor name="act_thigh_rr" joint="thigh_rr"/>
    <motor name="act_knee_rr" joint="knee_rr"/>
    <motor name="act_hip_rl" joint="hip_rl"/>
    <motor name="act_thigh_rl" joint="thigh_rl"/>
    <motor name="act_knee_rl" joint="knee_rl"/>
  </actuator>

  <sensor>
    <jointpos name="q_hip_fr" joint="hip_fr"/>
    <jointpos name="q_thigh_fr" joint="thigh_fr"/>
    <jointpos name="q_knee_fr" joint="knee_fr"/>
    <jointpos name="q_hip_fl" joint="hip_fl"/>
    <jointpos name="q_thigh_fl" joint="thigh_fl"/>
    <jointpos name="q_knee_fl" joint="knee_fl"/>
    <jointpos name="q_hip_rr" joint="hip_rr"/>
    <jointpos name="q_thigh_rr" joint="thigh_rr"/>
    <jointpos name="q_knee_rr" joint="knee_rr"/>
    <jointpos name="q_hip_rl" joint="hip_rl"/>
    <jointpos name="q_thigh_rl" joint="thigh_rl"/>
    <jointpos name="q_knee_rl" joint="knee_rl"/>
    <jointvel name="dq_hip_fr" joint="hip_fr"/>
    <jointvel name="dq_thigh_fr" joint="thigh_fr"/>
    <jointvel name="dq_knee_fr" joint="knee_fr"/>
    <jointvel name="dq_hip_fl" joint="hip_fl"/>
    <jointvel name="dq_thigh_fl" joint="thigh_fl"/>
    <jointvel name="dq_knee_fl" joint="knee_fl"/>
    <jointvel name="dq_hip_rr" joint="hip_rr"/>
    <jointvel name="dq_thigh_rr" joint="thigh_rr"/>
    <jointvel name="dq_knee_rr" joint="knee_rr"/>
    <jointvel name="dq_hip_rl" joint="hip_rl"/>
    <jointvel name="dq_thigh_rl" joint="thigh_rl"/>
    <jointvel name="dq_knee_rl" joint="knee_rl"/>
    <jointactuatorfrc name="tau_hip_fr" joint="hip_fr"/>
    <jointactuatorfrc name="tau_thigh_fr" joint="thigh_fr"/>
    <jointactuatorfrc name="tau_knee_fr" joint="knee_fr"/>
    <jointactuatorfrc name="tau_hip_fl" joint="hip_fl"/>
    <jointactuatorfrc name="tau_thigh_fl" joint="thigh_fl"/>
    <jointactuatorfrc name="tau_knee_fl" joint="knee_fl"/>
    <jointactuatorfrc name="tau_hip_rr" joint="hip_rr"/>
    <jointactuatorfrc name="tau_thigh_rr" joint="thigh_rr"/>
    <jointactuatorfrc name="tau_knee_rr" joint="knee_rr"/>
    <jointactuatorfrc name="tau_hip_rl" joint="hip_rl"/>
    <jointactuatorfrc name="tau_thigh_rl" joint="thigh_rl"/>
    <jointactuatorfrc name="tau_knee_rl" joint="knee_rl"/>
    <accelerometer name="imu_acc" site="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
  </sensor>

  <custom>
    <!-- peak torque [Nm], rated torque [Nm], no-load speed [rad/s], rated speed [rad/s], total ratio -->
    <numeric name="ak60_joint_limits" data="36.54 12.18 11.55 8.85 34.8"/>
  </custom>
</mujoco>
