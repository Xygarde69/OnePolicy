<mujoco model="DOggo_AK60_primitive_geoms">
  <!--
    Mesh-free primitive-geometry version of the supplied DOggo_AK60 model.

    Kinematic invariants retained from the source XML:
      - same free root and base pose
      - same four hip body positions and body quaternions
      - same nested hip -> thigh -> calf body hierarchy
      - same thigh and calf body offsets
      - same joint names, axes, and joint limits
      - same masses, inertial frames, and full inertia tensors
      - same 12 direct-torque actuators and sensor names

    The primitive geoms approximate the appearance/collision envelope only;
    they do not recreate the original CAD surfaces. No external meshes/assets
    are required. The hip axes are parallel as geometric lines; some are
    antiparallel by sign, intentionally preserving the source joint convention.
    The original thigh-to-calf offsets are preserved exactly, so no kinematic
    alignment has been changed to make the visual approximation look cleaner.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.25 0.25 0.25" specular="0.15 0.15 0.15"/>
    <map znear="0.01"/>
  </visual>

  <default>
    <joint armature="0.0295" damping="0.1" frictionloss="1.66" actuatorfrcrange="-36.54 36.54"/>
    <motor ctrlrange="-36.54 36.54"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1" rgba="0.18 0.65 0.42 1"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" friction="1 0.005 0.0001" rgba="0.18 0.65 0.42 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.1"
          rgba="0.24 0.26 0.29 1" friction="1 0.005 0.0001"/>

    <body name="base_link" pos="0 0 0.62">
      <freejoint name="root"/>
      <inertial pos="-1.39141166e-07 -0.000102367832 0.0376848659" mass="10.0"
                fullinertia="0.0692760121 0.0348926756 0.0901430041 -1.99000196e-06 2.93265177e-07 -4.73894399e-07"/>
      <!-- Rounded-box body proxy. Visual only; source base collision was mesh-based. -->
      <geom name="base_geom" class="visual" type="box" pos="0 0 0.015" size="0.19 0.29 0.055" rgba="0.16 0.19 0.23 1"/>
      <geom name="base_top" class="visual" type="box" pos="0 0 0.072" size="0.145 0.235 0.012" rgba="0.25 0.29 0.34 1"/>
      <site name="imu" pos="0 0 0" size="0.01" rgba="1 0.2 0.1 1"/>

      <!-- Front-right: all body/joint transforms copied from source. -->
      <body name="hip_fr" pos="0.065 0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="0.00107903741 -1.9324591e-05 0.0598853177" mass="1.38"
                  fullinertia="0.00163362208 0.00109655026 0.000919080121 4.27382957e-07 -2.46750206e-07 -3.70044953e-07"/>
        <joint name="hip_fr" axis="0 0 1" range="-0.8 0.8"/>
        <geom name="hip_fr_geom" class="visual" type="capsule" fromto="0 0 0 0 0 0.105" size="0.035"/>
        <geom name="hip_fr_hub" class="visual" type="cylinder" pos="0 0 0.02" quat="0.7071068 0.7071068 0 0" size="0.045 0.025" rgba="0.8 0.52 0.16 1"/>
        <body name="thigh_fr" pos="-0.028 0 0.072631">
          <inertial pos="-0.061426225 -0.0361303394 -0.00522454183" mass="1.38"
                    fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851942e-06 -1.02239875e-06 -0.000127235798"/>
          <joint name="thigh_fr" axis="-1 0 0" range="-1.57 1.57"/>
          <geom name="thigh_fr_geom" class="visual" type="capsule" fromto="0 0 0 -0.08928 -0.21278 0.0096672" size="0.027" rgba="0.18 0.65 0.42 1"/>
          <geom name="thigh_fr_joint_housing" class="visual" type="sphere" pos="0 0 0" size="0.039" rgba="0.8 0.52 0.16 1"/>
          <body name="calf_fr" pos="-0.08928 -0.21278 0.0096672">
            <inertial pos="0.00314980527 -0.138408659 -0.0146238989" mass="1.38"
                      fullinertia="0.00659921015 0.000624563237 0.00623224513 -2.80823743e-09 -4.74862427e-09 -0.00141145749"/>
            <joint name="knee_fr" axis="1 0 0" range="-2.5 2.5"/>
            <geom name="calf_fr_geom" class="collision" type="capsule" fromto="0 0 0 0 -0.245 0" size="0.022" rgba="0.72 0.76 0.81 1"/>
            <geom name="foot_fr" class="collision" type="sphere" pos="0 -0.245 0" size="0.032" rgba="0.12 0.13 0.15 1"/>
          </body>
        </body>
      </body>

      <!-- Front-left -->
      <body name="hip_fl" pos="-0.065 0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="-0.00107903741 1.9324591e-05 0.0598853177" mass="1.38"
                  fullinertia="0.00163362208 0.00109655026 0.000919080121 4.27382957e-07 2.46750206e-07 3.70044953e-07"/>
        <joint name="hip_fl" axis="0 0 -1" range="-0.8 0.8"/>
        <geom name="hip_fl_geom" class="visual" type="capsule" fromto="0 0 0 0 0 0.105" size="0.035"/>
        <geom name="hip_fl_hub" class="visual" type="cylinder" pos="0 0 0.02" quat="0.7071068 0.7071068 0 0" size="0.045 0.025" rgba="0.8 0.52 0.16 1"/>
        <body name="thigh_fl" pos="0.028 0 0.072631">
          <inertial pos="0.0614262309 -0.0367304728 -0.00484072113" mass="1.38"
                    fullinertia="0.00455960606 0.000808284909 0.00385414581 1.59851911e-06 -1.02239924e-06 -0.000127235798"/>
          <joint name="thigh_fl" axis="1 0 0" range="-1.57 1.57"/>
          <geom name="thigh_fl_geom" class="visual" type="capsule" fromto="0 0 0 0.079 -0.21278 0.0096672" size="0.027" rgba="0.18 0.65 0.42 1"/>
          <geom name="thigh_fl_joint_housing" class="visual" type="sphere" pos="0 0 0" size="0.039" rgba="0.8 0.52 0.16 1"/>
          <body name="calf_fl" pos="0.079 -0.21278 0.0096672">
            <inertial pos="0.00713020527 -0.138408977 -0.0146239567" mass="1.38"
                      fullinertia="0.00659919894 0.000624564926 0.00623223272 -2.8086668e-09 -4.74876255e-09 -0.00141145614"/>
            <joint name="knee_fl" axis="1 0 0" range="-2.5 2.5"/>
            <geom name="calf_fl_geom" class="collision" type="capsule" fromto="0 0 0 0 -0.245 0" size="0.022" rgba="0.72 0.76 0.81 1"/>
            <geom name="foot_fl" class="collision" type="sphere" pos="0 -0.245 0" size="0.032" rgba="0.12 0.13 0.15 1"/>
          </body>
        </body>
      </body>

      <!-- Rear-right -->
      <body name="hip_rr" pos="0.065 -0.166 0.054" quat="0 0 0.7071068 0.7071068">
        <inertial pos="0.00107903741 1.93245911e-05 -0.0598853177" mass="1.38"
